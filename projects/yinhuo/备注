CREATE TABLE IF NOT EXISTS `dubFile` (
  `id` char(64) NOT NULL COMMENT '主键ID',
  `duration` int(11) NOT NULL DEFAULT '0' COMMENT '时长',
  `content` text NOT NULL COMMENT '内容',
  `actorSpeaker` varchar(256) NOT NULL DEFAULT '' COMMENT '配音key',
  `actorName` varchar(256) NOT NULL DEFAULT '256' COMMENT '配音名称',
  `actorClassify` varchar(256) NOT NULL DEFAULT '' COMMENT '配音分类',
  `resourceId` varchar(256) NOT NULL DEFAULT '' COMMENT '资源Id',
  `text` text NOT NULL COMMENT '配音内容',
  `url` varchar(256) NOT NULL DEFAULT '' COMMENT '链接',
  `createTime` int(11) DEFAULT '0' COMMENT '创建时间',
  `updateTime` int(11) DEFAULT '0' COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `id` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='配音文件';

